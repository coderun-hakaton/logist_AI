    "uzbek_typography_rules": {
      "apostrophe_convention": "Use standard single quote or modifier letter apostrophe for oʻ and gʻ (O'zbekiston, yo'l, g'ildirak, og'irlik). Standardize on ' or ʻ consistently across all labels.",
      "casing_rules": "Buttons and section badges use Title Case in Uzbek (e.g., 'Yangi buyurtma yaratish', 'Haydovchi arizasi', 'Barcha buyurtmalar').",
      "currency_formatting": "Number with space grouping followed by so'm: e.g., '1 250 000 soʻm' or '3 400 000 UZS'.",
      "metric_units": "kg (kilogramm), t (tonna), km (kilometr), soat (hours), m³ (kub metr)."
